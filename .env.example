# Copy to .env (never commit secrets).
# With HOMEOPS_MOCK=1, missing vendor keys return clearly labeled mocks.
# When a vendor key is set, that adapter uses the real API.

# --- Guava: both voice legs (outbound shop call + in-app Ops) ---
# API key:     https://app.goguava.ai/dashboard/api-keys
#              (the `guava login` CLI session is NOT enough - the SDK
#              authenticates separately and 401s without this)
# Number:      guava numbers list
# WebRTC code: guava widget
GUAVA_API_KEY=
GUAVA_AGENT_NUMBER=
GUAVA_WEBRTC_CODE=

# --- Call safety ---
# No phone rings unless this is 1. Off by default so a test run, a stray
# script, or a fresh clone cannot dial a real person.
HOMEOPS_ALLOW_REAL_CALLS=0
# Refuse to dial the same number twice inside this window (runaway-loop guard).
HOMEOPS_CALL_COOLDOWN_SECONDS=60
# Dev/hackathon: the number the mocked trade search hands back, so the
# top-ranked [MOCK] shop can actually answer. 555 numbers are unroutable, so
# without this an end-to-end demo cannot connect. Leave blank in production.
HOMEOPS_DEV_SHOP_PHONE=

# --- Postgres (docker compose up -d) ---
DATABASE_URL=postgresql+asyncpg://homeops:homeops@localhost:5434/homeops

# --- Other vendors (all optional; mocked when unset) ---
EXA_API_KEY=
APIFY_TOKEN=
LIVE_PROVIDER=gemini
GEMINI_API_KEY=
OPENAI_API_KEY=

HOMEOWNER_NAME=
PORT=8000
HOMEOPS_MOCK=1

# Homeowner's cell for post-call SMS ("Booked — City Plumbing, Tuesday 10am").
# Requires SMS to be provisioned on GUAVA_AGENT_NUMBER (Guava enables this per
# number; without it the send fails with a 400 and is logged, never fatal).
HOMEOWNER_PHONE=
